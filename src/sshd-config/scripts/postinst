#!/bin/sh

set -eu

# Comment out the `KbdInteractiveAuthentication no` line if present
CONF="/etc/ssh/sshd_config"
if [ -f "$CONF" ]; then
    sed -i 's/^KbdInteractiveAuthentication[[:space:]]\+no/#KbdInteractiveAuthentication no/' "$CONF"
fi

# Restart an existing SSH server without making package installation wait on
# service ordering (himmelblaud may not be configured until after installation).
# Do not start an SSH server that the administrator left inactive.
if command -v systemctl >/dev/null 2>&1; then
    echo "Queuing restart of an active SSH service..."
    systemctl --no-block try-restart ssh 2>/dev/null || systemctl --no-block try-restart sshd 2>/dev/null || true
fi
