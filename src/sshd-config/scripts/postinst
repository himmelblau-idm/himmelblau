#!/bin/sh

set -eu

# Comment out the `KbdInteractiveAuthentication no` line if present
CONF="/etc/ssh/sshd_config"
if [ -f "$CONF" ]; then
    sed -i 's/^KbdInteractiveAuthentication[[:space:]]\+no/#KbdInteractiveAuthentication no/' "$CONF"
fi

# SSH is the deliberate non-blocking exception: himmelblaud is ordered before
# sshd, and its configuration may not be written until after this transaction.
# Waiting on an SSH restart here can therefore hold that configuration step.
# Submit the job in this scriptlet (no detached shell); systemd retains its unit
# ordering, but package completion does not imply the SSH restart has finished.
# Do not start an SSH server that the administrator left inactive.
if command -v systemctl >/dev/null 2>&1; then
    echo "Queuing restart of an active SSH service..."
    # try-restart succeeds for an inactive unit, so its status cannot select
    # between the Debian and RPM unit names. Select the active server first.
    for unit in ssh sshd; do
        if systemctl is-active --quiet "$unit" 2>/dev/null; then
            systemctl --no-block try-restart "$unit" 2>/dev/null || true
            break
        fi
    done
fi
