#!/bin/sh
set -e

# Himmelblau SSO policies postrm script
# Removes Firefox/Thunderbird extension configuration that was merged during install
# (Chrome/Chromium policy files are handled by package manager directly)

FIREFOX_EXTENSION_ID="linux-entra-sso@example.com"
FIREFOX_EXTENSION_URL="https://github.com/siemens/linux-entra-sso/releases/download/v1.13.0/linux_entra_sso-1.13.0.xpi"
THUNDERBIRD_EXTENSION_URL="https://github.com/siemens/linux-entra-sso/releases/download/v1.13.0/linux_entra_sso-1.13.0.thunderbird.xpi"
# URLs this package has written, past and current. Cleanup only touches these,
# so an admin's own pinned release or mirror is left alone. When bumping the
# version, add the old URL here (keep postinst and postrm in sync).
LINUX_ENTRA_SSO_RELEASES="https://github.com/siemens/linux-entra-sso/releases/download"
FIREFOX_MANAGED_URLS="$LINUX_ENTRA_SSO_RELEASES/v1.1.0/linux_entra_sso-1.1.0.xpi $LINUX_ENTRA_SSO_RELEASES/v1.3.1/linux_entra_sso-1.3.1.xpi $LINUX_ENTRA_SSO_RELEASES/v1.8.0/linux_entra_sso-1.8.0.xpi $LINUX_ENTRA_SSO_RELEASES/v1.9.1/linux_entra_sso-1.9.1.xpi $FIREFOX_EXTENSION_URL"
THUNDERBIRD_MANAGED_URLS="$LINUX_ENTRA_SSO_RELEASES/v1.8.0/linux_entra_sso-1.8.0.thunderbird.xpi $LINUX_ENTRA_SSO_RELEASES/v1.9.1/linux_entra_sso-1.9.1.thunderbird.xpi $THUNDERBIRD_EXTENSION_URL"

# Remove the Firefox ExtensionSettings entry added by postinst, and any
# Extensions.Install URL left by earlier versions of this package.
remove_firefox_policy() {
    POLICY_FILE="$1"
    EXTENSION_ID="$2"
    EXTENSION_MANAGED="$3"

    [ -f "$POLICY_FILE" ] || return 0
    if ! command -v jq >/dev/null 2>&1; then
        echo "Warning: jq not found. Cannot safely remove SSO extension from $POLICY_FILE"
        echo "Please manually remove \"$EXTENSION_ID\" from policies.ExtensionSettings"
        return 0
    fi

    TEMP_FILE=$(mktemp)
    # Remove only the fields postinst sets, and only when install_url is one of
    # our release URLs; keep any other keys an admin added to the entry.
    jq --arg id "$EXTENSION_ID" --arg managed "$EXTENSION_MANAGED" '
        if (.policies.ExtensionSettings[$id].install_url? // "" | (. as $u | any(($managed | split(" "))[]; . == $u))) then
            .policies.ExtensionSettings[$id] |= del(.installation_mode, .install_url)
            | if .policies.ExtensionSettings[$id] == {} then del(.policies.ExtensionSettings[$id]) else . end
        else . end
        | if .policies.ExtensionSettings == {} then del(.policies.ExtensionSettings) else . end
        | if .policies.Extensions.Install then
            .policies.Extensions.Install |= [.[] | select((type == "string" and (. as $u | any(($managed | split(" "))[]; . == $u))) | not)]
          else . end
        | if .policies.Extensions.Install == [] then del(.policies.Extensions.Install) else . end
        | if .policies.Extensions == {} then del(.policies.Extensions) else . end
    ' "$POLICY_FILE" > "$TEMP_FILE" && mv "$TEMP_FILE" "$POLICY_FILE"
    # mktemp creates 0600; the browser runs as the user and must read it
    chmod 0644 "$POLICY_FILE"
    echo "Removed Firefox SSO extension from $POLICY_FILE"

    if jq -e '.policies == {}' "$POLICY_FILE" >/dev/null 2>&1; then
        rm -f "$POLICY_FILE"
        echo "Removed empty policy file $POLICY_FILE"
    fi
}

# Function to remove a Mozilla extension from policies.json. Removes every
# URL in the managed list, not only the current one: a host upgraded without
# jq can still carry the URL an older version of this package wrote.
remove_mozilla_policy() {
    POLICY_FILE="$1"
    EXTENSION_MANAGED="$2"

    if [ -f "$POLICY_FILE" ]; then
        if command -v jq >/dev/null 2>&1; then
            # Remove the package-managed URLs from the Install array
            TEMP_FILE=$(mktemp)
            jq --arg managed "$EXTENSION_MANAGED" '
                if .policies.Extensions.Install then
                    .policies.Extensions.Install = [.policies.Extensions.Install[] | select((type == "string" and (. as $u | any(($managed | split(" "))[]; . == $u))) | not)]
                else
                    .
                end
            ' "$POLICY_FILE" > "$TEMP_FILE" && mv "$TEMP_FILE" "$POLICY_FILE"
            echo "Removed Mozilla SSO extension from $POLICY_FILE"

            # If the Install array is now empty, clean up the structure
            if jq -e '.policies.Extensions.Install == []' "$POLICY_FILE" >/dev/null 2>&1; then
                jq 'del(.policies.Extensions.Install)' "$POLICY_FILE" > "$TEMP_FILE" && mv "$TEMP_FILE" "$POLICY_FILE"
            fi
            # If Extensions is now empty, clean it up
            if jq -e '.policies.Extensions == {}' "$POLICY_FILE" >/dev/null 2>&1; then
                jq 'del(.policies.Extensions)' "$POLICY_FILE" > "$TEMP_FILE" && mv "$TEMP_FILE" "$POLICY_FILE"
            fi
            # If policies is now empty, remove the file
            if jq -e '.policies == {}' "$POLICY_FILE" >/dev/null 2>&1; then
                rm -f "$POLICY_FILE"
                echo "Removed empty policy file $POLICY_FILE"
            else
                # mktemp creates 0600; the browser runs as the user and must read it
                chmod 0644 "$POLICY_FILE"
            fi
        else
            echo "Warning: jq not found. Cannot safely remove SSO extension from $POLICY_FILE"
            echo "Please manually remove these linux_entra_sso URLs from policies.Extensions.Install:"
            for url in $EXTENSION_MANAGED; do
                echo "  $url"
            done
        fi
    fi
}

# Only run on Debian purge/remove or RPM erase ($1=0)
case "$1" in
    remove|purge|0)
        # Remove Firefox and Thunderbird policies
        remove_firefox_policy "/etc/firefox/policies/policies.json" "$FIREFOX_EXTENSION_ID" "$FIREFOX_MANAGED_URLS"
        remove_mozilla_policy "/etc/thunderbird/policies/policies.json" "$THUNDERBIRD_MANAGED_URLS"
        remove_mozilla_policy "/etc/betterbird/policies/policies.json" "$THUNDERBIRD_MANAGED_URLS"
        remove_mozilla_policy "/opt/betterbird/distribution/policies.json" "$THUNDERBIRD_MANAGED_URLS"

        echo "Himmelblau SSO Mozilla policy configuration removed"
        ;;
esac
