#!/bin/sh
set -e

config_file="/etc/himmelblau/himmelblau.conf"
saved_config="${config_file}.rpmsave"

# RPM creates .rpmsave after %post when an owned config is removed during an
# upgrade, so recover the previous local configuration at transaction end.
if [ -f "$saved_config" ] && [ ! -e "$config_file" ] && [ ! -L "$config_file" ]; then
    echo "Restoring Himmelblau configuration from $saved_config"
    if ! mv -- "$saved_config" "$config_file"; then
        echo "Failed to restore Himmelblau configuration from $saved_config" >&2
        exit 1
    fi

    if command -v systemctl >/dev/null 2>&1; then
        systemctl --no-block try-restart himmelblaud.service himmelblaud-tasks.service 2>/dev/null || true
    fi
fi

# Installed policy sources alone do not imply a later SELinux %posttrans: a
# daemon-only upgrade leaves the policy package outside the transaction. RPM's
# INSTALLTID identifies the transaction that installed each package.
selinux_updated_in_transaction() {
    command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled || return 1
    [ -d /usr/share/selinux/packages/himmelblaud ] || return 1
    daemon_tid=$(rpm -q --qf '%{INSTALLTID}' himmelblau 2>/dev/null) || return 1
    policy_tid=$(rpm -q --qf '%{INSTALLTID}' himmelblau-selinux 2>/dev/null) || return 1
    case "$daemon_tid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$daemon_tid" = "$policy_tid" ]
}

# Restore pre-upgrade running services after the old package's %preun stop.
# Defer only when the SELinux package was installed in this transaction and its
# later %posttrans exit handler will attempt recovery after loading policy,
# including when the policy script skips or fails its installation.
if command -v systemctl >/dev/null 2>&1 && [ -d /run/himmelblau-package-restart ]; then
    if selinux_updated_in_transaction; then
        echo "Deferring upgrade service recovery until SELinux policy installation"
    else
        state_dir=/run/himmelblau-package-restart
        for unit in himmelblaud.service himmelblaud-tasks.service; do
            if [ -f "$state_dir/$unit" ]; then
                # Wait for readiness outside the package process. A queued
                # job can fail after systemd accepts it; keep its marker.
                (
                    if systemctl start "$unit"; then
                        rm -f "$state_dir/$unit"
                        rmdir "$state_dir" 2>/dev/null || true
                    fi
                ) </dev/null >/dev/null 2>&1 &
            fi
        done
        rmdir "$state_dir" 2>/dev/null || true
    fi
fi
