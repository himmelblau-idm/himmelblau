/etc/himmelblau/himmelblau.conf r,
capability dac_read_search,
capability dac_override,
/var/cache/private/himmelblaud/himmelblau.conf r,
/run/himmelblaud/socket rw,
# Ubuntu's unix-chkpwd profile attaches disconnected paths under this prefix.
/att/unix-chkpwd/run/himmelblaud/socket rw,
/var/cache/nss-himmelblau/mapping.cache.db rw,
/var/cache/nss-himmelblau/cache.db rk,
